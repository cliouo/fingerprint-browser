{
  "manifest_version": 3,
  "name": "fpb runner-tab test",
  "version": "1.0.0",
  "description": "Test only: opens and closes its own tabs and posts a result to the local mock backend; its options page takes a context from `fpb open --ext-context`.",
  "permissions": [
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8100/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "fpb-runner-test@example.com"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
