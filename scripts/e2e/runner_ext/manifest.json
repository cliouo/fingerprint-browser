{
  "manifest_version": 3,
  "name": "fpb runner-tab test",
  "version": "1.0.0",
  "description": "Test only: opens and closes its own tabs and posts a result to the local mock backend.",
  "permissions": [
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:8100/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "fpb-runner-test@example.com"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'"
  }
}
